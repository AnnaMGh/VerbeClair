# Executed files cannot survive a line-ending rewrite. `core.autocrlf=true`
# rewrites LF to CRLF on checkout, and a `#!/bin/sh` whose first line ends in \r
# fails with `bad interpreter: /bin/sh^M`.
gradlew                             text eol=lf
*.sh                                text eol=lf
*.py                                text eol=lf
detekt.yml                          text eol=lf
.editorconfig                       text eol=lf
# The other direction: cmd.exe is sensitive to line endings inside a multi-line
# construct, so a batch file normalised to LF can fail in ways that are hard to read.
*.bat                               text eol=crlf
*.cmd                               text eol=crlf
