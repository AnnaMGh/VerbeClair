<?xml version="1.0" encoding="utf-8"?>
<!--
    The verb database is replaced from the bundled copy at start-up (design D4), so it is never backed up:
    at 156 MB it would also exceed Auto Backup's 25 MB quota and stop the whole backup. Everything else,
    user.db and the app-settings DataStore included, is backed up.
-->
<!-- Android 11 (API 30) and earlier. -->
<full-backup-content>
    <exclude domain="database" path="verbs.db" />
    <exclude domain="database" path="verbs.db-wal" />
    <exclude domain="database" path="verbs.db-shm" />
    <exclude domain="database" path="verbs.db-journal" />
    <exclude domain="database" path="verbs.db.lck" />
    <exclude domain="database" path="verbs.db.tmp" />
</full-backup-content>
